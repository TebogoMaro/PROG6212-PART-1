@model CategoriesViewModel
@{
    ViewData["Title"] = "Categories";
    var ev = Model.Event;
}
<p class="rd-eyebrow"><a asp-action="Events">My events</a> / @ev.EventName</p>
<h1 class="rd-page-title">Categories</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card rd-card">
            <div class="card-body">
                <h2 class="rd-section-title">Categories for this event</h2>
                @if (ev.Categories.Count == 0)
                {
                    <p class="text-muted mb-0">No categories yet. Add a distance category (10km) or an age category (Under 20) using the form.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table rd-table align-middle">
                            <thead><tr><th>Category</th><th>Distance</th><th>Places</th><th>Fee</th><th class="text-end">Manage</th></tr></thead>
                            <tbody>
                            @foreach (var c in ev.Categories)
                            {
                                <tr>
                                    <td><strong>@c.CategoryName</strong></td>
                                    <td>@(c.DistanceKm is null ? "Age group" : Display.Km(c.DistanceKm.Value))</td>
                                    <td>@c.MaxParticipants</td>
                                    <td>@Display.Money(c.EntryFee)</td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <a asp-action="CategoryRoute" asp-route-categoryId="@c.CategoryId" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark btn-sm" title="Route"><i class="bi bi-signpost-2"></i></a>
                                            <a asp-action="EditCategory" asp-route-id="@c.CategoryId" class="btn btn-outline-dark btn-sm" title="Edit"><i class="bi bi-pencil"></i></a>
                                            <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Delete this category?');">
                                                <input type="hidden" name="id" value="@c.CategoryId" />
                                                <input type="hidden" name="eventId" value="@ev.EventId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card rd-card">
            <div class="card-body">
                <h2 class="rd-section-title">Add a category</h2>
                <form asp-action="AddCategory" method="post" novalidate>
                    <input type="hidden" asp-for="NewCategory.EventId" />
                    <div class="mb-3">
                        <label asp-for="NewCategory.CategoryName" class="form-label"></label>
                        <input asp-for="NewCategory.CategoryName" class="form-control" placeholder="10km, 21km, Under 20, Senior..." />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewCategory.DistanceKm" class="form-label"></label>
                        <input asp-for="NewCategory.DistanceKm" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="NewCategory.DistanceKm" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="NewCategory.MaxParticipants" class="form-label"></label>
                            <input asp-for="NewCategory.MaxParticipants" type="number" class="form-control" />
                            <span asp-validation-for="NewCategory.MaxParticipants" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="NewCategory.EntryFee" class="form-label"></label>
                            <input asp-for="NewCategory.EntryFee" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="NewCategory.EntryFee" class="text-danger small"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-rd w-100"><i class="bi bi-plus-circle"></i> Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="mt-4 d-flex gap-2 flex-wrap">
    <a asp-controller="Home" asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-outline-dark">View public page</a>
    <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark">Enrolments</a>
    <a asp-action="Results" asp-route-eventId="@ev.EventId" class="btn btn-outline-dark">Results</a>
</div>
@section Scripts { <partial name="_ValidationScripts" /> }

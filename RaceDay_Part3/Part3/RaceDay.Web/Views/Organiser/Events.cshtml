@model List<MyEventDto>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="rd-page-title mb-0">My events</h1>
    <a asp-action="CreateEvent" class="btn btn-rd"><i class="bi bi-plus-circle"></i> Create event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-empty">
        <i class="bi bi-calendar-plus"></i>
        <h2>No events yet</h2>
        <p>Create your first event, then add categories for people to enter.</p>
        <a asp-action="CreateEvent" class="btn btn-rd">Create event</a>
    </div>
}
else
{
    <div class="card rd-card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table rd-table align-middle">
                    <thead><tr><th>Event</th><th>Date</th><th>Location</th><th class="text-center">Enrolments</th><th class="text-end">Manage</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.OrderBy(x => x.EventDate))
                    {
                        <tr class="@(Display.IsUpcoming(e.EventDate) ? "" : "rd-past")">
                            <td>
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@e.EventId" class="fw-semibold">@e.EventName</a>
                                <div class="small text-muted"><i class="bi @Display.EventIcon(e.EventType)"></i> @e.EventType - @Display.Km(e.DistanceKm)</div>
                            </td>
                            <td>@Display.Date(e.EventDate)</td>
                            <td>@e.Location</td>
                            <td class="text-center"><span class="badge rd-count-badge">@e.EnrolmentCount</span></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="EditEvent" asp-route-id="@e.EventId" class="btn btn-outline-dark" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Categories" asp-route-eventId="@e.EventId" class="btn btn-outline-dark" title="Categories"><i class="bi bi-tags"></i></a>
                                    <a asp-action="Enrolments" asp-route-eventId="@e.EventId" class="btn btn-outline-dark" title="Enrolments"><i class="bi bi-people"></i></a>
                                    <a asp-action="Results" asp-route-eventId="@e.EventId" class="btn btn-outline-dark" title="Results"><i class="bi bi-stopwatch"></i></a>
                                    <a asp-action="ConfirmDelete" asp-route-id="@e.EventId" class="btn btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

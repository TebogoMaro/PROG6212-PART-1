@model EventFormModel
@{
    var isEdit = Model.EventId is not null;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
}
<p class="rd-eyebrow">@(isEdit ? "Update your event" : "New event")</p>
<h1 class="rd-page-title">@ViewData["Title"]</h1>

<div class="card rd-card">
    <div class="card-body">
        <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Sandton, Gauteng" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">Run</option>
                        <option value="Walk">Walk</option>
                        <option value="Cycle">Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistanceKm" class="form-label"></label>
                    <input asp-for="DistanceKm" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="DistanceKm" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Banner" class="form-label"></label>
                    @if (Model.HasBanner)
                    {
                        <div class="mb-2"><img src="/media/event/@Model.EventId" class="rd-banner-preview" alt="Current banner" /></div>
                    }
                    <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
                    <div class="form-text">JPG, PNG or WebP, up to 5 MB. @(isEdit ? "Choose a new image only if you want to replace the current banner." : "Optional - shown on the event page.")</div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScripts" /> }

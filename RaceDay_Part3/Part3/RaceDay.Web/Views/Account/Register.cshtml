@model RegisterViewModel
@{
    ViewData["Title"] = "Join RaceDay";
}
<div class="rd-auth">
    <div class="card rd-card">
        <div class="card-body">
            <p class="rd-eyebrow">Get started</p>
            <h1 class="rd-page-title">Join RaceDay</h1>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">I am a...</label>
                    <div class="rd-role-choice">
                        <input type="radio" class="btn-check" name="Role" id="role-participant" value="Participant" checked="@(Model.Role != AppRoles.Organiser)" />
                        <label class="btn btn-outline-dark" for="role-participant"><i class="bi bi-person-walking"></i> Participant<small>Enter events and track results</small></label>
                        <input type="radio" class="btn-check" name="Role" id="role-organiser" value="Organiser" checked="@(Model.Role == AppRoles.Organiser)" />
                        <label class="btn btn-outline-dark" for="role-organiser"><i class="bi bi-clipboard-data"></i> Organiser<small>Create and manage events</small></label>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
                <div class="mb-3" id="organiser-code" style="display:none">
                    <label asp-for="OrganiserCode" class="form-label"></label>
                    <input asp-for="OrganiserCode" class="form-control" autocomplete="off" />
                    <div class="form-text">Organisers need the registration code from RaceDay so nobody can promote themselves.</div>
                    <span asp-validation-for="OrganiserCode" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-rd w-100">Create account</button>
            </form>
            <p class="mt-3 mb-0 text-center small">Already have an account? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScripts" />
    <script>
        (function () {
            var box = document.getElementById('organiser-code');
            function sync() { box.style.display = document.getElementById('role-organiser').checked ? 'block' : 'none'; }
            document.querySelectorAll('input[name="Role"]').forEach(function (r) { r.addEventListener('change', sync); });
            sync();
        })();
    </script>
}

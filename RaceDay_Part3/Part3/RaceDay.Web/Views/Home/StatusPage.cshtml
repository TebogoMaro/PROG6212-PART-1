@{
    var code = ViewData["Code"] is int c ? c : 500;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="rd-empty">
    @if (code == 404)
    {
        <i class="bi bi-compass"></i>
        <h2>We couldn't find that page</h2>
        <p>The page you're looking for may have moved, or the event may have been removed.</p>
    }
    else if (code == 403)
    {
        <i class="bi bi-shield-lock"></i>
        <h2>You don't have access to that</h2>
        <p>Your role doesn't have access to this area of RaceDay.</p>
    }
    else
    {
        <i class="bi bi-emoji-dizzy"></i>
        <h2>Something went wrong</h2>
        <p>Please try again in a moment.</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-rd">Back to home</a>
</div>
